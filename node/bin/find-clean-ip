#!/usr/bin/env bash
# Перебирает адреса, пока не попадётся годный под Google: создать → проверить →
# при провале удалить и повторить.
#
#   ./bin/find-clean-ip        до 10 попыток
#   ./bin/find-clean-ip 25     до 25
#
# Перебирать не жалко: минимальная единица списания у Hetzner — час, то есть
# одна попытка стоит около 1.1 евроцента.
#
# ВАЖНО, чего этот скрипт НЕ делает: он не меняет адрес у существующего узла.
# Он создаёт и удаляет сервера в цикле, поэтому требует, чтобы сервера не было.
# Если надо заменить только адрес, сохранив сервер, ключи и клиентов, это
# другая процедура и руками:
#
#   hcloud server poweroff <имя>          # Primary IP на живом сервере не сменить
#   hcloud primary-ip unassign <id>       # старый оставить в проекте, не удалять
#   hcloud primary-ip create --type ipv4 --datacenter <dc> --name <имя>
#   hcloud primary-ip assign --server <имя> <новый>
#   hcloud server poweron <имя>
#   ./bin/check-ip                        # годен ли новый адрес под Google
#
# После этого адрес правится в config.yaml (четыре места: два server: в
# proxies, skip-dst-address в сниффере, правило IP-CIDR) и в .secrets.yaml
# (NODE_S_IP), а клиентам перевыпускаются ссылки: ./bin/client show <имя>.
source "$(dirname "$0")/../lib/common.sh"
need hcloud; need_token

TRIES="${1:-10}"
[ -n "${TRIES//[0-9]/}" ] && die "число попыток, а не «$TRIES»"

hcloud server describe "$SERVER_NAME" >/dev/null 2>&1 \
  && die "сервер $SERVER_NAME существует. Этот скрипт создаёт и удаляет сервера в цикле и живой узел трогать не должен. Для пересоздания с нуля: ./bin/destroy. Для замены только адреса — см. шапку этого файла, это делается руками"

for i in $(seq 1 "$TRIES"); do
  say "попытка $i из $TRIES"
  ./bin/create >/dev/null || die "не смог создать сервер"
  IP="$(node_ip)"
  if ./bin/check-ip "$IP"; then
    ok "годный адрес найден с попытки $i: $IP"
    say "дальше: ./bin/apply"
    exit 0
  fi
  bad "$IP не годится, удаляю"
  hcloud server delete "$SERVER_NAME" >/dev/null
done
die "за $TRIES попыток годный адрес не попался — возможно, дело в самой локации ($LOCATION), попробуй другую в node.conf"
