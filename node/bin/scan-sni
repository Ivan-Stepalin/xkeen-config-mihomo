#!/usr/bin/env bash
# Разведка: какие имена живут по соседству с узлом и годятся как доноры
# Reality по формальным признакам.
#
#   ./bin/scan-sni          соседи по /24
#   ./bin/scan-sni 22       вчетверо шире, дольше
#   ./bin/scan-sni --write  ещё и вписать лучшего в node.conf
#
# ВАЖНО: для узлов, которыми пользуются из РФ, результат этого сканера
# применять нельзя. Замер 27.08.2026 показал, что обрыв следует за известностью
# имени в SNI, а сканер ранжирует по времени рукопожатия и потому выводит
# наверх обскурные микросайты — худших доноров из возможных. Донора выбирает
# ./bin/pick-donor замером из дома. Этот скрипт остаётся разведкой: посмотреть,
# что за имена вообще есть в подсети.
source "$(dirname "$0")/../lib/common.sh"
need hcloud; need_token

PREFIX="24"; WRITE=0
for a in "$@"; do
  case "$a" in
    22|24) PREFIX="$a" ;;
    --write) WRITE=1 ;;
    *) die "не понял аргумент: $a" ;;
  esac
done

IP="$(node_ip)"
say "сканирую с $IP, подсеть /$PREFIX"

OUT="$(rssh "$IP" "bash -s -- $PREFIX" < remote/scan-sni.sh)" || { echo "$OUT"; die "сканер упал"; }
echo "$OUT" | sed '/###BEST###/,$d'

BEST="$(echo "$OUT" | sed -n '/###BEST###/,$p' | tail -n +2 | tr -d '[:space:]')"
[ -n "$BEST" ] || die "ни один кандидат не прошёл проверку — попробуй ./bin/scan-sni 22"

ok "лучший донор: $BEST"
if [ "$WRITE" = 1 ]; then
  set_conf SNI_XHTTP "$BEST"
else
  say "node.conf не тронут — так и надо, см. шапку скрипта"
fi

cat <<TXT

Сканер померил путь «узел → донор». Про путь «дом → узел», который и душат,
отсюда не видно ничего: имя, быстрое из датацентра, встаёт на первом окне TCP
у российского оператора — именно так и вышло с lucaslucid.com.
Выбирать донора: ./bin/pick-donor --pin
TXT
