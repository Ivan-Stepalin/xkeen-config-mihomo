.DS_Store
# Реальные ссылки подписок — подставляются в config.yaml smudge-фильтром.
.secrets.yaml
# Кэш подписок: mihomo перезаписывает его сам, версионировать нечего, а внутри
# лежат узлы с UUID. Сам каталог удалён 27.08.2026 вместе с устаревшим кэшом,
# но правила оставлены страховкой: если mihomo когда-нибудь запустят из
# репозитория, кэш появится снова.
proxy-providers/*.yaml
proxy-providers/*.url

# Банк памяти Claude. Лежит в проекте, чтобы знание жило рядом с конфигом, но
# не трекается: внутри адрес узла, порты, ссылки подписок и почта аккаунтов.
# Чтобы часть записей всё же версионировать — вычистить реквизиты и добавить
# сюда исключение вида: !.claude/memory/имя.md
/.claude/memory/

# Проект выходного узла: приватные ключи Reality, UUID устройств, собранный
# конфиг Xray и QR с рабочим доступом. Сам код проекта версионируется.
/node/secrets/

# Байткод Python из node/lib — создаётся при каждом запуске скриптов проекта.
__pycache__/
*.pyc
