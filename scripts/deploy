#!/usr/bin/env bash
# Заливает config.yaml на роутер и применяет его.
#
#   scripts/deploy            проверить, залить, перечитать конфиг через API
#   scripts/deploy --restart  то же, но вместо перечитывания — xkeen -restart
#
# Горячее перечитывание не трогает перехват портов и не рвёт соединения,
# поэтому оно по умолчанию. Перезапуск нужен, когда меняется то, что mihomo
# читает только при старте: redir/tproxy-порты, external-controller, слушатель
# DNS, tun.
#
# Доступ на роутер — по ключу на dropbear из Entware. Ключ кладётся один раз,
# причём в /opt/etc/dropbear/authorized_keys: dropbear в Entware собран с патчем
# OpenWrt и для root ~/.ssh/authorized_keys не читает, отказывая молча.
#   ssh -p 222 root@192.168.1.1 'mkdir -p /opt/etc/dropbear && chmod 700 /opt/etc/dropbear \
#     && cat >> /opt/etc/dropbear/authorized_keys && chmod 600 /opt/etc/dropbear/authorized_keys' \
#     < ~/.ssh/id_ed25519.pub
set -euo pipefail

ROUTER="${ROUTER:-192.168.1.1}"
SSH_PORT="${ROUTER_SSH_PORT:-222}"
SSH_USER="${ROUTER_SSH_USER:-root}"
REMOTE_CONF="${ROUTER_CONF:-/opt/etc/mihomo/config.yaml}"
API="${MIHOMO_API:-http://$ROUTER:9090}"

cd "$(dirname "$0")/.."

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
ok()  { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m  !\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mОшибка:\033[0m %s\n' "$*" >&2; exit 1; }

RESTART=0
for a in "$@"; do
  case "$a" in
    --restart) RESTART=1 ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "не понял аргумент: $a" ;;
  esac
done

# Пароль не спрашиваем: без ключа команда должна упасть сразу и сказать, что
# делать, а не зависнуть в ожидании ввода.
rssh() {
  ssh -p "$SSH_PORT" -o BatchMode=yes -o ConnectTimeout=8 -o LogLevel=ERROR \
      "$SSH_USER@$ROUTER" "$@"
}
api() { curl -s -m 8 "$@"; }

# На роутер уходит config.yaml с подставленными плейсхолдерами. Обычно рабочий
# файл и так содержит реальные значения (их возвращает smudge-фильтр), но часть
# реквизитов держится плейсхолдерами и на диске — см. «Турция (резидентский)».
WORK="$(mktemp -d -t deploy)"; trap 'rm -rf "$WORK"' EXIT
CONF="$WORK/config.yaml"
ruby scripts/unscrub.rb < config.yaml > "$CONF"
if grep -n -E '\$\{[A-Z_]+\}' "$CONF"; then
  die "плейсхолдеры без значения в .secrets.yaml — заливка отменена"
fi

# ───────────────────────────────────────────────────── проверка
say "проверка config.yaml"
ruby scripts/validate.rb || die "валидатор нашёл ошибки, заливка отменена"

if command -v mihomo >/dev/null; then
  # Единственный способ поймать опечатку в имени поля: валидатор смотрит на
  # структуру, а не на схему mihomo. Каталог одноразовый — тест качает в него
  # гео-базы и кэш провайдеров.
  T="$WORK/test"; mkdir "$T"
  if ! mihomo -t -d "$T" -f "$CONF" >"$T/out" 2>&1; then
    cat "$T/out"; die "mihomo не принял конфиг"
  fi
  ok "mihomo -t: конфиг принят"
else
  warn "локального mihomo нет (brew install mihomo) — проверка схемы пропущена"
fi

# rules/*.yaml роутер тянет с GitHub, а не отсюда: правка вступит в силу
# только после push. Напоминаем, если правки застряли локально.
if [ -n "$(git status --porcelain rules/)" ]; then
  warn "в rules/ есть незакоммиченные правки — роутер их не увидит до push"
elif git rev-parse --verify -q '@{upstream}' >/dev/null \
     && [ -n "$(git log '@{upstream}..' --oneline -- rules/)" ]; then
  warn "в rules/ есть коммиты, не ушедшие в origin — роутер их не увидит до push"
fi

# ───────────────────────────────────────────────────── заливка
say "роутер $SSH_USER@$ROUTER:$SSH_PORT"
rssh true 2>/dev/null || die "нет доступа по ключу. Один раз, руками (спросит пароль):
  ssh -p $SSH_PORT $SSH_USER@$ROUTER 'mkdir -p /opt/etc/dropbear && chmod 700 /opt/etc/dropbear \\
    && cat >> /opt/etc/dropbear/authorized_keys && chmod 600 /opt/etc/dropbear/authorized_keys' \\
    < ~/.ssh/id_ed25519.pub"
rssh "test -f '$REMOTE_CONF'" \
  || die "на роутере нет $REMOTE_CONF — путь другой? задайте ROUTER_CONF=…"

# Через stdin, а не scp: dropbear без пакета scp его не имеет, а cat есть
# всегда. Сначала во временный файл, потом mv — mihomo не увидит полуфайл.
if rssh "cmp -s '$REMOTE_CONF' -" < "$CONF"; then
  ok "на роутере уже этот конфиг"
else
  rssh "cat > '$REMOTE_CONF.new' && cp '$REMOTE_CONF' '$REMOTE_CONF.prev' \
        && mv '$REMOTE_CONF.new' '$REMOTE_CONF'" < "$CONF"
  ok "залит, предыдущий сохранён как $(basename "$REMOTE_CONF").prev"
fi

# ───────────────────────────────────────────────────── применение
ROLLBACK="ssh -p $SSH_PORT $SSH_USER@$ROUTER 'cp $REMOTE_CONF.prev $REMOTE_CONF && xkeen -restart'"
if [ "$RESTART" = 1 ]; then
  say "xkeen -restart"
  rssh "xkeen -restart" 2>&1 | sed 's/^/    /' || true
else
  say "перечитываю конфиг через API"
  CODE="$(api -o /dev/null -w '%{http_code}' -X PUT "$API/configs?force=true" \
            -H 'Content-Type: application/json' \
            -d "{\"path\":\"$REMOTE_CONF\"}")" || CODE=000
  case "$CODE" in
    204) ;;
    000) die "API $API не отвечает; откат: $ROLLBACK" ;;
    *)   api -X PUT "$API/configs?force=true" -H 'Content-Type: application/json' \
             -d "{\"path\":\"$REMOTE_CONF\"}"; echo
         die "mihomo отверг конфиг (HTTP $CODE); на роутере остался новый файл, откат: $ROLLBACK" ;;
  esac
fi

# После перезапуска mihomo поднимается не мгновенно, даём до 30 секунд.
for i in $(seq 1 30); do
  VER="$(api "$API/version" | ruby -rjson -e 'puts JSON.parse(STDIN.read)["version"]' 2>/dev/null)" && [ -n "$VER" ] && break
  sleep 1
done
[ -n "${VER:-}" ] || die "mihomo не поднялся за 30 с; откат: $ROLLBACK"
ok "mihomo $VER отвечает"

# ───────────────────────────────────────────────────── сверка
say "сверка с роутером"
ruby scripts/validate.rb --live | grep -E 'роутер|ОШИБКА|ПРЕДУПРЕЖДЕНИЕ' | sed 's/^/    /' || true
ok "готово"
